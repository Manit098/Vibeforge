{
  "compilerOptions": {
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "module": "commonjs",
    "target": "es2020",
    "types": ["node", "jest"],
    "lib": ["esnext"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
